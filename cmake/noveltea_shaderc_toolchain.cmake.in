# Import the complete static link closure for the pinned NovelTea shader compiler.
get_filename_component(_noveltea_shaderc_prefix "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(_noveltea_shaderc_import target archive)
    if(TARGET "${target}")
        return()
    endif()
    add_library("${target}" STATIC IMPORTED GLOBAL)
    set_target_properties("${target}" PROPERTIES
        IMPORTED_LOCATION "${_noveltea_shaderc_prefix}/lib/${archive}")
endfunction()

_noveltea_shaderc_import(noveltea_shaderc::embedded libnoveltea_bgfx_shaderc_embedded.a)
_noveltea_shaderc_import(noveltea_shaderc::fcpp libfcpp.a)
_noveltea_shaderc_import(noveltea_shaderc::glslang libglslang.a)
_noveltea_shaderc_import(noveltea_shaderc::glsl_optimizer libglsl-optimizer.a)
_noveltea_shaderc_import(noveltea_shaderc::spirv_opt libspirv-opt.a)
_noveltea_shaderc_import(noveltea_shaderc::spirv_cross libspirv-cross.a)
_noveltea_shaderc_import(noveltea_shaderc::bimg libbimg.a)
_noveltea_shaderc_import(noveltea_shaderc::bx libbx.a)

set_target_properties(noveltea_shaderc::embedded PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES
        "${_noveltea_shaderc_prefix}/include/bgfx/tools/shaderc;${_noveltea_shaderc_prefix}/include/bgfx/src;${_noveltea_shaderc_prefix}/include/bx"
    INTERFACE_LINK_LIBRARIES
        "noveltea_shaderc::fcpp;noveltea_shaderc::glslang;noveltea_shaderc::glsl_optimizer;noveltea_shaderc::spirv_opt;noveltea_shaderc::spirv_cross;noveltea_shaderc::bimg;noveltea_shaderc::bx;${CMAKE_DL_LIBS};rt")

set(NOVELTEA_SHADERC_TOOLCHAIN_RESOURCE_DIR "${_noveltea_shaderc_prefix}/resources")
unset(_noveltea_shaderc_prefix)
